    "superseded_by": "",
    "article": "第10条",
    "paragraph": "",
    "content": "建立劳动关系，应当订立书面劳动合同。已建立劳动关系，未同时订立书面劳动合同的，应当自用工之日起一个月内订立书面劳动合同。",
    "source": "全国人民代表大会常务委员会",
    "category": "劳动",
    "scope": "特别",
    "partially_invalid": false,
    "invalid_parts": "",
    "trial": false,
