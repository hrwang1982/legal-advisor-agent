    "promulgation_date": "2023-12-29",
    "effective_date": "2024-07-01",
    "effective_to": "",
    "validity": "现行有效",
    "superseded_by": "",
    "article": "第59条",
    "paragraph": "",
    "content": "股东会行使下列职权：（一）选举和更换董事、监事，决定有关董事、监事的报酬事项；（二）审议批准董事会的报告；（三）审议批准监事会的报告；（四）审议批准公司的利润分配方案和弥补亏损方案；（五）对公司增加或者减少注册资本作出决议；（六）对发行公司债券作出决议；（七）对公司合并、分立、解散、清算或者变更公司形式作出决议；（八）修改公司章程；（九）公司章程规定的其他职权。",
    "source": "全国人民代表大会常务委员会",
    "category": "公司",
    "scope": "特别",
    "partially_invalid": false,
    "invalid_parts": "",
    "trial": false,
    "verified": true,
    "note": "",
    "norm_type": "substantive",
    "article_effective_date": "2024-07-01"
  },
  {
    "law_name": "中华人民共和国公司法",
    "document_number": "主席令第15号（2023年修订）",
    "hierarchy": "法律",
    "host_law": "",
    "host_hierarchy": "",
    "promulgation_date": "2023-12-29",
