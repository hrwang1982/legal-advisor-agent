# —— 运行模式 ——
# true=免密钥演示(MOCK)；false=接入真实大模型（支持阿里千问 Qwen / 本地 Ollama·vLLM / DeepSeek）
MOCK=true

# —— 大模型平台标识：qwen / local_openai / siliconflow / deepseek ——
LLM_PROVIDER=qwen

# —— LLM（OpenAI 兼容接口，示例 1：阿里云百炼通义千问 DashScope）——
LLM_API_KEY=your-api-key
LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.0
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2

# —— LLM（示例 2：本地 Ollama / vLLM / Xinference OpenAI 兼容服务）——
# LLM_API_BASE=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:14b
# LLM_API_KEY=EMPTY

# —— 嵌入向量模型（推荐 BAAI/bge-m3，支持 OpenAI /v1/embeddings 兼容接口与本地特征向量回退）——
EMBED_ENABLED=true
EMBED_API_KEY=
EMBED_API_BASE=http://localhost:11434/v1
EMBED_MODEL=BAAI/bge-m3
HYBRID_DENSE_WEIGHT=0.45

# —— 检索 / 数据 / 外置知识配置 / 向量库路径 ——
TOP_K=5
DATA_PATH=app/data/sample_laws.json
KNOWLEDGE_CONFIG_PATH=app/data/knowledge_config.json
KB_DB_PATH=app/data/kb_vectors.db
STRICT_REVIEW_AUTH=false

# —— 服务 ——
HOST=0.0.0.0
PORT=8000
